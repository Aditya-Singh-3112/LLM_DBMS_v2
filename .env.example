APP_NAME=LLM-Powered DBMS
APP_ENV=development
DEBUG=true

MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=llm_dbms

REDIS_URI=redis://localhost:6379/0

POSTGRES_URI=postgresql://postgres:postgres@localhost:5432/llm_dbms
POSTGRES_MIN_POOL_SIZE=
POSTGRES_MAX_POOL_SIZE=

JWT_SECRET=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=
REFRESH_TOKEN_EXPIRE_DAYS=

GOOGLE_API_KEY=your-api-key

# MCP server the agent calls its tools through (uvicorn app.mcp_server.main:app --port 8001)
MCP_SERVER_URL=http://localhost:8001/mcp

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# Auth cookie (set COOKIE_SECURE=true behind HTTPS; required when APP_ENV != development)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Limits
ASK_DAILY_LIMIT=200
# Daily LLM tokens per user (input + output); 0 = unlimited
ASK_DAILY_TOKEN_LIMIT=0
ASK_TIMEOUT_SECONDS=90
# Storage per database in MB (writes/imports that grow past it are rolled back); 0 = unlimited
DATABASE_MAX_MB=500
# Largest tables a write may touch and still be undoable, in MB; 0 disables undo
UNDO_MAX_MB=50

# Sign-in lockout: failures per email / per client IP within the window
LOGIN_MAX_FAILURES=5
LOGIN_MAX_FAILURES_PER_IP=50
LOGIN_LOCKOUT_MINUTES=15

# Email (verification, password reset). "console" logs messages instead of sending.
EMAIL_BACKEND=console
FRONTEND_URL=http://localhost:3000
EMAIL_FROM=LLM-DBMS <no-reply@localhost>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# Prometheus metrics at /metrics on both the API and the MCP server
METRICS_ENABLED=true

# Set false to run without the vector store / embedding model (tests, CI)
RAG_ENABLED=true

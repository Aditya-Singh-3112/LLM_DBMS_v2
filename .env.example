APP_NAME=LLM-Powered DBMS
APP_ENV=development
DEBUG=true

MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=llm_dbms

REDIS_URI=redis://localhost:6379/0

POSTGRES_URI=postgresql://postgres:postgres@localhost:5432/llm_dbms
POSTGRES_MIN_POOL_SIZE=
POSTGRES_MAX_POOL_SIZE=

JWT_SECRET=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=
REFRESH_TOKEN_EXPIRE_DAYS=

GOOGLE_API_KEY=your-api-key

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# Auth cookie (set COOKIE_SECURE=true behind HTTPS; required when APP_ENV != development)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Limits
ASK_DAILY_LIMIT=200
ASK_TIMEOUT_SECONDS=90

# Set false to run without the vector store / embedding model (tests, CI)
RAG_ENABLED=true
